{
  "name": "xiaozhi-server",
  "version": "1.0.0",
  "description": "小智(Xiaozhi) 语音交互服务器 - 独立运行版（不依赖 galaclaw）",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node run-server.js",
    "dev": "node --watch run-server.js",
