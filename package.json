    "web:dev": "pnpm --dir studio/web dev"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.6.1",
    "element-plus": "^2.14.6",
    "esptool-js": "^0.7.0",
    "express": "^4.22.1",
    "hap-controller": "^0.10.2",
    "node-edge-tts": "^1.2.10",
    "node-lame": "^2.0.2",
    "opusscript": "^0.1.1",
    "uuid": "^13.0.0",
    "vue": "^3.5.43",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=18"
