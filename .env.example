# 端口 / 监听
XIAOZHI_PORT=8003
XIAOZHI_HOST=0.0.0.0

# 设备库/对话库路径（默认 ./data/xz.db；如需共享旧库可指向 galaclaw 的 gala.db）
# XZ_DB_PATH=/absolute/path/to/xz.db

# 日志
XZ_LOG_LEVEL=info
XZ_LOG_TO_FILE=1
# XZ_LOG_DIR=./logs

# LLM 走 bridge：openai(直连 aibridge) 或 dsh(经 dsh-xiaozhi-bridge)
STT_PROVIDER=funasr
FUNASR_HOST=localhost
FUNASR_PORT=10096

# openai 直连端点鉴权（provider=openai 时）
AIBRIDGE_API_KEY=
